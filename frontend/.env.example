# Where Next.js proxies /api/* (FastAPI). Default: http://localhost:8000
API_PROXY_TARGET=http://localhost:8000
# Optional: call the API directly from the browser instead of via the proxy
# (then add this site's origin to CORS_ORIGINS on the backend).
NEXT_PUBLIC_API_BASE_URL=

# Fallback only: the timezone normally comes from the API (backend INSTITUTION_TIMEZONE).
NEXT_PUBLIC_INSTITUTION_TIMEZONE=Asia/Kolkata
